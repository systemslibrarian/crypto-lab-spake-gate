    "@types/node": "^26.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^1.5.0"
